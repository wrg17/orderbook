#!/usr/bin/env bash
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
  echo "pre-push: docker not found in PATH" >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "pre-push: docker daemon not reachable" >&2
  exit 1
fi

echo "==> pre-push: make verify"
make verify
echo "==> pre-push: ok"
